# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=USER_CONFIGURED_IN_APP

# Supabase client-side credentials.
# Use the Project URL and publishable/anon key from Supabase Dashboard > Connect.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Google OAuth Web Client ID.
# Get this from Google Cloud Console > APIs & Services > Credentials.
# Must be the OAuth 2.0 Web application client ID (not Android).
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
